# FormPilot configuration. Copy to .env (`make up` does this for you).
# Never commit .env. This file must only ever contain placeholders and local-dev defaults.

# --- Security ---------------------------------------------------------------
# Required. At least 32 characters. `make up` generates one with `openssl rand -hex 32`
# when it creates .env. Leave empty here.
JWT_SECRET=
JWT_TTL_MINUTES=60
# Required. Fernet key for the profile vault and for the sensitive and phone values in stored
# forms. `make up` generates one. Losing it makes the saved profiles unreadable. Leave empty here.
VAULT_KEY=
# Set to true when served over HTTPS.
COOKIE_SECURE=false
# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:3000

# --- Postgres (docker compose) -----------------------------------------------
# Local development credentials only; the port is bound to 127.0.0.1.
# POSTGRES_PASSWORD MUST be changed to a strong random value for any deployment
# (and DATABASE_URL updated to match).
POSTGRES_USER=formpilot
POSTGRES_PASSWORD=formpilot
POSTGRES_DB=formpilot
# Host port for the compose Postgres (5432 is often taken by a local install).
POSTGRES_HOST_PORT=5433

# --- Backend running on the host (tests, alembic, CLI) ----------------------
# Inside docker compose these are overridden to point at the service names.
DATABASE_URL=postgresql+psycopg://formpilot:formpilot@localhost:5433/formpilot
REDIS_URL=redis://localhost:6379/0
# Host port for the compose Redis.
REDIS_HOST_PORT=6379
# Host port for the compose API.
API_HOST_PORT=8000

# --- Storage and retention --------------------------------------------------
STORAGE_ROOT=./var/storage
FILE_TTL_HOURS=24

# --- Uploads ----------------------------------------------------------------
# Checked by the API (size, PDF magic bytes) and the worker (pages). Page images for the viewer
# are rendered by the worker at PAGE_IMAGE_DPI.
# The web app's size check reads the same value at build time (NEXT_PUBLIC_MAX_UPLOAD_MB in
# docker-compose.yml), so changing it needs a web rebuild (`make up` rebuilds).
MAX_UPLOAD_MB=20
MAX_PAGES=50
PAGE_IMAGE_DPI=144

# --- Background jobs --------------------------------------------------------
JOB_TIMEOUT_SECONDS=300

# --- Field understanding (LLM) ------------------------------------------------
# "auto" (default): Groq when GROQ_API_KEY is set, with local Ollama as the fallback, else Ollama
# (decision P4-D1). Also "groq", "ollama" or "none" (rule matcher only). If no model can be
# reached, analysis falls back to the rules. Values of sensitive and phone types are never sent
# to a remote provider; Groq, an Ollama cloud model (a ":cloud" tag) and a non-local host count
# as remote.
LLM_PROVIDER=auto
# Groq: keep the key in .env only; never commit it. Empty = no Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Ollama on this machine. Inside docker compose the worker uses http://host.docker.internal:11434.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# A local 8B model can take minutes per request on a busy laptop.
LLM_TIMEOUT_SECONDS=300
UNDERSTAND_REVIEW_THRESHOLD=0.7

# --- Filling (Phase 4) -------------------------------------------------------
# Precision-first fill policy (decision P4-D2, chosen on dev): an LLM-typed field is filled
# from the profile only at this confidence; names and dates at most once per form.
FILL_MIN_CONFIDENCE=0.99
FILL_ONCE_PER_FORM=true
# Suggested values (decision P5-D1): an LLM-typed field below FILL_MIN_CONFIDENCE but at least
# this confident is prefilled as "suggested" and printed only after the user confirms it.
SUGGEST_MIN_CONFIDENCE=0.95
# Fit pass: default and smallest font size (points).
FIT_FONT_SIZE=10
FIT_MIN_FONT_SIZE=6

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# --- Web --------------------------------------------------------------------
# The API URL as seen from the browser. Inlined into the web bundle at build time, so changing
# it needs a rebuild (`make up` rebuilds).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Host port for the compose web app. Its origin (http://localhost:3000) must be in CORS_ORIGINS.
WEB_HOST_PORT=3000
